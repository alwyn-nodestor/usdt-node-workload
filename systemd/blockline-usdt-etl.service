[Unit]
Description=blockline-usdt ETL: follow the node's solidified head into Tier 2 in ClickHouse (Phase 1)
After=blockline-usdt-node.service blockline-usdt-clickhouse.service
Wants=blockline-usdt-node.service
Requires=blockline-usdt-clickhouse.service

[Service]
User=usdt
Group=usdt
WorkingDirectory=/home/usdt/blockline-usdt
ExecStart=/home/usdt/blockline-usdt/bin/blockline-usdt etl live
# Node not answering: the ETL retries inside. A block that fails its checks exits 2 and is retried here every
# 5 minutes; the error stays on the status page until it clears.
Restart=on-failure
RestartSec=300
Nice=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/blockline-usdt/state
PrivateTmp=yes
MemoryMax=8G

[Install]
WantedBy=multi-user.target
