[Unit]
Description=blockline-usdt history (Phase 2): blocks 0 up to where the live ETL began, epoch by epoch, into ClickHouse
After=blockline-usdt-node.service blockline-usdt-clickhouse.service blockline-usdt-etl.service
Wants=blockline-usdt-node.service
Requires=blockline-usdt-clickhouse.service
# The history ends at the live run's first block, so it never starts before the live ETL has begun
# (bin/usdt-up starts it right after the live ETL, once the node is synced).
ConditionPathExists=/srv/blockline-usdt/state/etl-live.json

[Service]
User=usdt
Group=usdt
WorkingDirectory=/home/usdt/blockline-usdt
# Range workers at a time, 6 node calls each (96 in flight at 16). Every epoch resumes from its own cursor
# (state/etl-range-FROM-TO.json), so a stop or reboot loses at most one unflushed batch per worker. To change it:
# edit here, then daemon-reload and restart this unit (running epochs resume where they stopped).
Environment=BLOCKLINE_USDT_HISTORY_WORKERS=16
ExecStart=/home/usdt/blockline-usdt/bin/blockline-usdt etl history
# A block that fails its checks exits 2: retried every 5 minutes, the error stays on the status page.
Restart=on-failure
RestartSec=300
# Runs for weeks after the node is synced; lower CPU priority than the node and the live ETL, so they keep up.
Nice=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/blockline-usdt/state
PrivateTmp=yes
# each worker holds up to 1,000 blocks of rows before a flush
MemoryMax=40G

[Install]
WantedBy=multi-user.target
