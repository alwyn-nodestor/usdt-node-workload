#!/usr/bin/env bash
# blockline-usdt: bring the whole stack up, in order, and wait for each step before the next.
#
#   bin/usdt-up [--sync-timeout HOURS]        as usdt (or as debian: usdt's steps then run through sudo -u usdt)
#
#   1. preflight     disk, ETL venv
#   2. units         the systemd units are installed (else: run the root bootstrap, printed below, and re-run this)
#   3. install       JDK, FullNode.jar, config, ClickHouse binary (idempotent; pinned by sha256 in lib/usdt_node.py)
#   4. clickhouse    the Tier 2 store answers on 127.0.0.1:18123
#   5. snapshot      stream and verify the ~3.9 TB snapshot (about 37 h; skipped once node/.snapshot-verified exists)
#   6. node          the FullNode unit runs and its API answers on 127.0.0.1:18090
#   7. sync          the head is within SYNC_BEHIND_S seconds of the clock, for SYNC_CONFIRM checks in a row
#   8. etl           the live ETL follows the solidified head (state/etl.json)
#   9. dashboard     the status page on 127.0.0.1:8288, then one bin/usdt-status report
#
# Every step checks before it acts, so re-running after an interruption (or a reboot) continues where it stopped.
# Stopping this script stops nothing: the snapshot and the node run under systemd. Log: state/logs/up.log.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
# shellcheck source=../lib/compat.sh
. "$here/lib/compat.sh"
ROOT=${BLOCKLINE_USDT_ROOT:-/srv/blockline-usdt}
NODE=$ROOT/node
STATE=$ROOT/state
HTTP=127.0.0.1:18090
SOLID=127.0.0.1:18091
CH=127.0.0.1:18123
SYNC_BEHIND_S=60       # same threshold as the status page's "synced"
SYNC_CONFIRM=3         # consecutive checks, POLL_S apart
POLL_S=60
SNAPSHOT_TB=4.3        # extracted snapshot (about 4.1 TB) plus room; the stream itself keeps a 0.2 TB reserve

sync_timeout_h=0
while [ $# -gt 0 ]; do
  case $1 in
    --sync-timeout) sync_timeout_h=$2; shift ;;
    -h|--help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"; exit 0 ;;
    *) echo "unknown option: $1 (see --help)"; exit 2 ;;
  esac
  shift
done

mkdir -p "$STATE/logs" 2>/dev/null || true
exec > >(tee -a "$STATE/logs/up.log") 2>&1
if command -v flock >/dev/null 2>&1; then
  exec 9>"$STATE/up.lock"; flock -n 9
else
  mkdir "$STATE/up.lock.d" 2>/dev/null
fi || { echo "another usdt-up is running (lock $STATE/up.lock)"; exit 1; }
command -v flock >/dev/null 2>&1 || trap 'rmdir "$STATE/up.lock.d" 2>/dev/null' EXIT

log() { printf '%s %s\n' "$(date -u '+%F %T')" "$*"; }
step() { printf '\n%s == %s\n' "$(date -u '+%F %T')" "$*"; }
die() { log "STOP: $*"; exit 1; }

as_usdt() { run_as usdt "$@"; }
ctl()      { svc_ctl "$1" "$2"; }
active()   { svc_active "$1"; }
installed(){ svc_installed "$1"; }
# head (or solidified) block as "number timestamp_ms"; empty when the API does not answer
block() { curl -sf -m 5 "http://$1/$2/getnowblock" | jq -r '.block_header.raw_data | "\(.number) \(.timestamp)"' 2>/dev/null; }
hm() { local s=${1%.*}; [ "$s" -lt 0 ] && s=0; printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60)); }

# ---------------------------------------------------------------------------------------------------------------------
step "1/9 preflight"
[ "$(id -un)" = root ] && die "run as usdt or a regular user, not root (only the bootstrap needs root)"
for tool in curl jq python3; do command -v $tool >/dev/null || die "$tool is not installed"; done
free_tb=$(awk -v b="$(free_bytes "$ROOT")" 'BEGIN { printf "%.2f", b/1e12 }')
log "free disk at $ROOT: $free_tb TB"
[ -x "$here/.venv/bin/python" ] || die "no ETL venv at $here/.venv (docs/ETL.md: uv venv + pyarrow, pycryptodome)"

# ---------------------------------------------------------------------------------------------------------------------
step "2/9 systemd units"
missing=()
for u in snapshot node clickhouse etl dashboard; do installed $u || missing+=("blockline-usdt-$u"); done
if [ ${#missing[@]} -gt 0 ]; then
  log "not installed: ${missing[*]}"
  log "install them once as root, then re-run this script:"
  log "  sudo bash $here/bootstrap/usdt-bootstrap.sh"
  exit 1
fi
log "all five units installed"

# ---------------------------------------------------------------------------------------------------------------------
step "3/9 runtime (JDK, java-tron, config, ClickHouse)"
as_usdt "$here/bin/blockline-usdt" install

# ---------------------------------------------------------------------------------------------------------------------
step "4/9 ClickHouse"
active clickhouse || ctl start clickhouse
for _ in $(seq 60); do curl -sf -m 3 "http://$CH/?query=SELECT%201" >/dev/null && break; sleep 5; done
curl -sf -m 3 "http://$CH/?query=SELECT%201" >/dev/null || die "ClickHouse does not answer on $CH (journalctl -u blockline-usdt-clickhouse)"
log "ClickHouse answers on $CH"

# ---------------------------------------------------------------------------------------------------------------------
step "5/9 snapshot"
if [ -e "$NODE/.snapshot-verified" ]; then
  log "already verified: $(cat "$NODE/.snapshot-verified")"
else
  if ! active snapshot; then
    awk -v f="$free_tb" -v n="$SNAPSHOT_TB" 'BEGIN { exit !(f < n) }' && die "$free_tb TB free; the snapshot needs about $SNAPSHOT_TB TB"
    base=$(python3 -c "import sys; sys.path.insert(0, '$here/lib'); import usdt_node as u; print(u.SNAPSHOT['base'] + '/' + u.SNAPSHOT['file'])")
    size=$(curl -sfI -m 30 "$base" | tr -d '\r' | awk 'tolower($1) == "content-length:" { print $2 }')
    [ -n "$size" ] || die "snapshot mirror does not answer: $base"
    log "snapshot: $base, $(awk -v b="$size" 'BEGIN { printf "%.2f TB", b/1e12 }')"
    # `systemctl start` waits for a oneshot to finish (about 37 h) and sudoers allows no --no-block, so it goes in the
    # background; ending this script leaves the job running in systemd
    ctl start snapshot & disown
    sleep 10
  fi
  log "streaming; progress every 10 minutes (the status page shows it live)"
  while [ ! -e "$NODE/.snapshot-verified" ]; do
    st=$(jq -r '"\(.status) \(.percent // 0)% at \(.rate_mb_s // "-") MB/s, ETA \(.eta_hours // "-") h\(if .error then ", error: " + .error else "" end)"' \
      "$STATE/snapshot.json" 2>/dev/null || echo "starting")
    log "snapshot: $st"
    if ! active snapshot && [ ! -e "$NODE/.snapshot-verified" ]; then
      sleep 15; [ -e "$NODE/.snapshot-verified" ] && break
      die "the snapshot unit stopped before verifying: journalctl -u blockline-usdt-snapshot -n 50 (re-running downloads again)"
    fi
    sleep 600
  done
  log "snapshot verified"
fi

# ---------------------------------------------------------------------------------------------------------------------
step "6/9 node"
active node || ctl start node      # normally already started by the snapshot unit (OnSuccess)
log "waiting for the API on $HTTP (java-tron takes a few minutes to open the database)"
for i in $(seq 120); do
  [ -n "$(block "$HTTP" wallet)" ] && break
  active node || die "the node unit is not running: journalctl -u blockline-usdt-node -n 50"
  [ $((i % 5)) -eq 0 ] && log "still opening the database ($((i * 30 / 60)) min)"
  sleep 30
done
[ -n "$(block "$HTTP" wallet)" ] || die "the node did not answer on $HTTP within an hour"
log "node answers: head $(block "$HTTP" wallet | cut -d' ' -f1)"

# ---------------------------------------------------------------------------------------------------------------------
step "7/9 sync (head within ${SYNC_BEHIND_S}s of the clock, $SYNC_CONFIRM checks in a row)"
started=$(date +%s) ok=0 prev_n= prev_t=
while :; do
  read -r n ts < <(block "$HTTP" wallet || true) || true
  now=$(date +%s)
  if [ -z "${n:-}" ]; then
    active node || die "the node unit stopped: journalctl -u blockline-usdt-node -n 50"
    log "node not answering; retrying"; ok=0
  else
    behind=$(( now - ts / 1000 ))
    solid=$(block "$SOLID" walletsolidity | cut -d' ' -f1)
    peers=$(curl -sf -m 5 "http://$HTTP/wallet/getnodeinfo" | jq -r '.currentConnectCount // "?"' 2>/dev/null || echo "?")
    rate= eta=
    if [ -n "$prev_n" ] && [ "$now" -gt "$prev_t" ]; then
      rate=$(awk -v a="$prev_n" -v b="$n" -v s=$((now - prev_t)) 'BEGIN { printf "%.1f", (b - a) / s }')
      # the chain itself moves one block every 3 s, so catch-up gains (rate - 1/3) blocks a second
      eta=$(awk -v r="$rate" -v g="$behind" 'BEGIN { if (r > 0.34) printf "%d", g / 3 / (r - 1/3); else print "" }')
    fi
    log "head $n · solid ${solid:-?} · ${peers} peers · $(hm $behind) behind${rate:+ · $rate blocks/s}${eta:+ · ETA $(hm $eta)}"
    if [ "$behind" -lt "$SYNC_BEHIND_S" ]; then ok=$((ok + 1)); else ok=0; fi
    [ $ok -ge $SYNC_CONFIRM ] && break
    prev_n=$n prev_t=$now
  fi
  if [ "$sync_timeout_h" != 0 ] && [ $((now - started)) -gt $((sync_timeout_h * 3600)) ]; then
    die "not synced after $sync_timeout_h h (the node keeps running; re-run to keep waiting)"
  fi
  sleep $POLL_S
done
log "node synced: head $n, solidified $solid"

# ---------------------------------------------------------------------------------------------------------------------
step "8/9 ETL"
active etl || ctl start etl
for _ in $(seq 20); do
  upd=$(jq -r '.updated // empty' "$STATE/etl.json" 2>/dev/null || true)
  [ -n "$upd" ] && [ $(( $(date +%s) - $(date_to_epoch "$upd") )) -lt 120 ] && break
  sleep 15
done
active etl || die "the ETL unit is not running: journalctl -u blockline-usdt-etl -n 50"
log "ETL: $(jq -r '"\(.state // "?") · last block \(.live.last_block // "?") · \(.live.lag_blocks // "?") behind solidified\(if .error then " · error: " + .error else "" end)"' "$STATE/etl.json" 2>/dev/null || echo "no report yet")"

# ---------------------------------------------------------------------------------------------------------------------
step "9/9 dashboard"
ctl restart dashboard
for _ in $(seq 10); do curl -sf -m 3 http://127.0.0.1:8288/api/status >/dev/null && break; sleep 2; done
curl -sf -m 3 http://127.0.0.1:8288/api/status >/dev/null || die "the status page does not answer on 127.0.0.1:8288"
log "status page up: ssh -L 8288:127.0.0.1:8288 debian@<server>, then http://localhost:8288"
echo
"$here/bin/usdt-status" || true
echo
log "done. Check again any time with bin/usdt-status (bin/usdt-status --watch for a live view)"
