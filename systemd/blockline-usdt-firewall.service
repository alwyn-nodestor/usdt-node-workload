[Unit]
Description=blockline-usdt: keep the node's HTTP and gRPC APIs off the network (java-tron binds them to every interface)
Before=blockline-usdt-node.service
Wants=network-pre.target
After=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/blockline-usdt/firewall.nft
ExecStop=/usr/sbin/nft delete table inet blockline_usdt

[Install]
WantedBy=multi-user.target
