<!-- blockline-usdt ClickHouse server (docs/CLICKHOUSE.md). Installed to /srv/blockline-usdt/clickhouse/config.xml by
     `bin/blockline-usdt install`. Loopback only; no other ports (interserver, MySQL, PostgreSQL) are opened. -->
<clickhouse>
  <logger>
    <level>warning</level>
    <log>/srv/blockline-usdt/clickhouse/log/server.log</log>
    <errorlog>/srv/blockline-usdt/clickhouse/log/error.log</errorlog>
    <size>100M</size>
    <count>5</count>
  </logger>
  <listen_host>127.0.0.1</listen_host>
  <http_port>18123</http_port>
  <tcp_port>19000</tcp_port>
  <path>/srv/blockline-usdt/clickhouse/data/</path>
  <tmp_path>/srv/blockline-usdt/clickhouse/tmp/</tmp_path>
  <user_files_path>/srv/blockline-usdt/clickhouse/user_files/</user_files_path>
  <format_schema_path>/srv/blockline-usdt/clickhouse/format_schemas/</format_schema_path>
  <!-- zstd everywhere: parquet-sized storage (benchmark 2026-11-12: 0.97x parquet; LZ4 was 1.6-1.9x) -->
  <compression><case><method>zstd</method><level>3</level></case></compression>
  <!-- RAM: the node takes 24 GB, Postgres and clustering share the rest (PLAN.md 9) -->
  <max_server_memory_usage>17179869184</max_server_memory_usage>
  <mark_cache_size>2147483648</mark_cache_size>
  <uncompressed_cache_size>1073741824</uncompressed_cache_size>
  <!-- query and part logs grow without end on a single box; keep a week -->
  <query_log><database>system</database><table>query_log</table><ttl>event_date + INTERVAL 7 DAY</ttl></query_log>
  <part_log><database>system</database><table>part_log</table><ttl>event_date + INTERVAL 7 DAY</ttl></part_log>
  <trace_log remove="1"/>
  <metric_log remove="1"/>
  <asynchronous_metric_log remove="1"/>
  <text_log remove="1"/>
  <users>
    <default>
      <password></password>
      <networks><ip>127.0.0.1</ip></networks>
      <profile>default</profile>
      <quota>default</quota>
    </default>
  </users>
  <profiles><default><max_threads>8</max_threads></default></profiles>
  <quotas><default/></quotas>
</clickhouse>
