[Unit]
Description=blockline-usdt ClickHouse: Tier 2 store (127.0.0.1:18123 HTTP, 19000 native; docs/CLICKHOUSE.md)
After=network-online.target

[Service]
User=usdt
Group=usdt
WorkingDirectory=/srv/blockline-usdt/clickhouse
ExecStart=/srv/blockline-usdt/clickhouse/clickhouse server --config-file=/srv/blockline-usdt/clickhouse/config.xml
Restart=on-failure
RestartSec=10
LimitNOFILE=500000
TimeoutStopSec=120
# ClickHouse caps its own memory at 16 GB (config.xml). No soft limit here: it would count the page cache too and
# throttle reads, as it did to the node (PLAN.md change 24). The hard stop is only a backstop.
MemoryHigh=infinity
MemoryMax=48G
Nice=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/blockline-usdt/clickhouse
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
